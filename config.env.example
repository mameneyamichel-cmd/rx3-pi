# Copy to config.env at the repository root and uncomment the assignments.
# start-rx3.sh and stop-rx3.sh read that file. Paths inside the chroot
# (/dev/rx3-control, /proc/udev_usb1, /media/usb1/sda1, ...) stay unchanged.

# RX3_HOME=/home/pompu_5
# RX3_ROOTFS=/home/pompu_5/rx3-rootfs
# RX3_UID=1000
# RX3_GID=44
# RX3_GROUPS=29,44,995,991
# RX3_TOUCH_DEV=/dev/input/by-path/platform-1f00080000.i2c-event

# Pour prepare-runtime.py (UUID de la cle : lsblk -o NAME,FSTYPE,UUID)
# RX3_USB_UUID=0FFF-3865
# RX3_USB_UID=1000
# RX3_USB_GID=1000